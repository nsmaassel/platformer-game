# Godot 4+ specific ignores
.godot/

# Exported builds (committed only when deploying)
dist/

# OS
.DS_Store
Thumbs.db

# Editor metadata
.idea/
*.swp
*~

# VS Code — track settings.json and tasks.json, ignore personal files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json

# Game test logs (generated by test-game.ps1)
logs/

# Sprite generation artifacts (regenerated, not source)
sprites-review.png

# Python bytecode
__pycache__/
